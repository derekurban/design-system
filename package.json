{
  "name": "@derekurban/design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Derek Urban's design system: tokens, fonts, logos and React components.",
  "license": "UNLICENSED",
  "repository": { "type": "git", "url": "git+https://github.com/derekurban/design-system.git" },
  "homepage": "https://github.com/derekurban/design-system#readme",
  "bugs": "https://github.com/derekurban/design-system/issues",
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./src/index.d.ts",
  "style": "./dist/styles.css",
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./dist/index.js" },
    "./styles.css": "./dist/styles.css",
    "./tokens/*": "./tokens/*",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "components/**/*.d.ts", "components/**/*.prompt.md", "tokens", "assets", "readme.md", "SKILL.md"],
  "scripts": {
    "build": "rm -rf dist && esbuild src/index.js --bundle --format=esm --target=es2019 --jsx=transform --loader:.js=jsx --external:react --external:react-dom --sourcemap --outfile=dist/index.js && esbuild styles.css --bundle --loader:.woff2=file --asset-names=fonts/[name] --outfile=dist/styles.css",
    "check": "bash .github/scripts/check.sh",
    "prepare": "npm run build"
  },
  "peerDependencies": { "react": ">=18", "react-dom": ">=18" },
  "devDependencies": { "esbuild": "^0.24.0" }
}
